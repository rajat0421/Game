# Use exactly this name (or MONGODB_URI / DATABASE_URL — all supported in code)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/wordgame
SECRET_KEY=long-random-string-for-jwt
# Required in production (Vercel app URL, no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
# Optional: separate salt so daily word sequence is not guessable from date alone
DAILY_WORD_SALT=another-long-random-string
NODE_ENV=production
